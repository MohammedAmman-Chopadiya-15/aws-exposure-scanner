# ==========================================
# Security & Secret Files (CRITICAL)
# ==========================================

*.tfvars
*.tfvars.json
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# AWS credentials / local cache
.aws/
aws-credentials.json

# ==========================================
# Terraform Exclusions
# ==========================================

**/.terraform/

# Terraform state files (contains plain text secrets and environment details)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI configuration overrides
.terraformrc
terraform.rc

# Local standalone binaries
terraform.exe
terraform

# ==========================================
# Python & Virtual Environments (Backend/Lambdas)
# ==========================================

__pycache__/
*.py[cod]
*$py.class

# Python Virtual Environments
venv/
env/
ENV/
.venv/

# Distribution / packaging artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.zip

# Pytest / Coverage
.cache
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Node.js & React Frontend
# ==========================================

node_modules/

# Production build outputs
dist/
out/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite / bundler build cache
.vite/

# ==========================================
# Editor & OS Specific Files
# ==========================================

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace